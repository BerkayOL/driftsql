  "fixed_sql": [
    {
      "name": "buildings_table",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"buildings_table\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"country_code\" TEXT NOT NULL, \"construction_year\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "floors_table",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"floors_table\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"building_id\" INTEGER NOT NULL REFERENCES buildings_table (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"floor_number\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "rooms_table",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rooms_table\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"floor_id\" INTEGER NOT NULL REFERENCES floors_table (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"is_heated\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_heated\" IN (0, 1)), \"target_temperature\" REAL NULL, \"area\" REAL NOT NULL CHECK(\"area\" > 0.0), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "offline_photos_table",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"offline_photos_table\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"image_path\" TEXT NOT NULL, \"room_id\" INTEGER NULL REFERENCES rooms_table (id) ON DELETE SET NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "pending_file_cleanup_table",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pending_file_cleanup_table\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"file_path\" TEXT NOT NULL UNIQUE, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
